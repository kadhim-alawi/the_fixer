# Option A -- Gemini API (fastest to start)
GOOGLE_API_KEY=

# Option B -- Vertex AI (preferred for the submission: inference stays inside
# Google Cloud alongside Cloud Run and Cloud SQL). Leave GOOGLE_API_KEY empty.
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Override the model if a newer Gemini ships before the deadline.
# FIXER_MODEL=gemini-3.5-flash
