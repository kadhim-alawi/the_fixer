# Vertex AI (preferred -- keeps inference inside Google Cloud and produces
# Vertex logs, which the submission video needs as proof of Google Cloud).
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
# NOTE: Gemini 3.x is served from the "global" Vertex location. This is NOT the
# region your Cloud Run service runs in -- a regional value here returns 404.
GOOGLE_CLOUD_LOCATION=global
FIXER_MODEL=gemini-3.5-flash

# Alternative: a Gemini API key from aistudio.google.com/apikey
# GOOGLE_API_KEY=
